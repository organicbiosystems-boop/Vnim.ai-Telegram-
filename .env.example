# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Канал, куда публикуем (бот должен быть админом канала с правом публикации)
CHANNEL_ID=@VnimAi
# Telegram user id ваш и партнёра через запятую (узнать: написать @userinfobot)
ADMIN_IDS=111111111,222222222
# Ключ Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# --- необязательные настройки ---
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
POLL_INTERVAL_MIN=10
SIGNATURE=VNIM.AI
INCLUDE_SOURCE_LINK=true
AUTO_PUBLISH_BREAKING=true
MAX_ITEMS_PER_RUN=15
MAX_AGE_HOURS=24
# Самообучение: сколько ваших решений нужно, прежде чем бот начнёт сам публиковать обычные новости
LEARNING_MIN_DECISIONS=30
# Требуемая точность: среди новостей выше порога вы должны были одобрять >= 95%
LEARNING_TARGET_PRECISION=0.95
DB_PATH=data/bot.db
FEEDS_FILE=feeds.txt
